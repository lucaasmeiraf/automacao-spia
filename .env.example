# ============================================================
#  Copie este arquivo para ".env" e preencha com valores reais.
#  O .env NUNCA deve ir para o Git (já está no .gitignore).
# ============================================================

# --- OpenAI ---
# Chave da API. Gere uma NOVA em https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-COLOQUE_SUA_CHAVE_NOVA_AQUI
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Sistema SUPRA / DNIT ---
# Token de acesso à API do DNIT (o antigo "token" das variáveis globais do n8n).
# Gere/renove um token novo — o anterior foi exposto e deve ser considerado comprometido.
DNIT_TOKEN=COLOQUE_SEU_TOKEN_NOVO_AQUI
DNIT_BASE_URL=https://supra.dnit.gov.br/index_cgcont_common.php/cgcont/ai

# --- Legendas (usadas em alguns tópicos, ex.: controle pluviométrico) ---
LEGENDAS=1 - Bom | 2 - Chuva | 3 - Impraticável | 5 - Instável | 4 - Não houveram atividades

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Comportamento de rede ---
HTTP_TIMEOUT=120        # segundos para chamadas externas (DNIT/OpenAI)
HTTP_MAX_RETRIES=2      # tentativas extras em caso de falha temporária
