# ============================================================
#  Copie este arquivo para ".env" e preencha com valores reais.
#  O .env NUNCA deve ir para o Git (já está no .gitignore).
#  Um .env por ambiente (dev / homolog / prod), cada um com valores PRÓPRIOS.
# ============================================================

# --- Ambiente ---
# dev | homolog | prod. Se ausente, assume "prod" (o mais restritivo: sem rotas de administração).
ENV=dev

# ============================================================
#  SEGURANÇA
# ============================================================

# Chave que o SISTEMA CHAMADOR envia no header "X-API-Key" ao chamar POST /webhook/relatorio.
# Sem ela o webhook responde 503 (nunca fica aberto). Mínimo 32 caracteres.
# Gere com:   python -m scripts.gerar_chave
WEBHOOK_API_KEY=

# Administradores da tela de configuração (só existe com ENV=dev).
# Formato: JSON {"usuario": "hash"} entre ASPAS SIMPLES (o hash contém '$').
# Guarda apenas o HASH da senha — NUNCA a senha. Gere (vários admins = vários nomes) com:
#   python -m scripts.gerar_hash_senha lucas.meira outro.admin
ADMIN_USERS='{}'

# Cookie de sessão só trafega em HTTPS. Mantenha true. Se acessar por http:// puro (sem TLS)
# o navegador descarta o cookie e o login não funciona — use um proxy reverso com HTTPS.
COOKIE_SECURE=true

# Expiração da sessão de login (opcional).
# SESSION_IDLE_MINUTES=30      # por inatividade
# SESSION_MAX_HOURS=8          # tempo absoluto

# Documentação interativa (/docs). Desligada por padrão e IGNORADA fora de ENV=dev.
# ENABLE_DOCS=false

# ============================================================
#  INTEGRAÇÕES  (valores que hoje estão no n8n — veja as dicas)
# ============================================================

# --- OpenAI ---
# n8n: nó "Define Variáveis Globais" -> campo "token-openai"
#      (os nós "LLM…" também usam a credencial "OpenAI" do n8n: menu Credentials).
# Recomendado: gerar uma chave NOVA em https://platform.openai.com/api-keys (a antiga
# ficou exposta no JSON do n8n) e revogar a antiga.
OPENAI_API_KEY=sk-proj-COLOQUE_SUA_CHAVE_AQUI
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Sistema SUPRA / DNIT ---
# n8n: nó "Define Variáveis Globais" -> campo "token" (é um JWT, começa com "eyJ").
#      O mesmo JWT está no header "token" dos nós HTTP que chamam o SUPRA.
# Recomendado: renovar o token no SUPRA, pois o anterior foi exposto.
DNIT_TOKEN=COLOQUE_O_JWT_DO_SUPRA_AQUI
DNIT_BASE_URL=https://supra.dnit.gov.br/index_cgcont_common.php/cgcont/ai

# --- Legendas (usadas em alguns tópicos, ex.: controle pluviométrico) ---
# n8n: nó "Define Variáveis Globais" -> campo "legendas"
LEGENDAS=1 - Bom | 2 - Chuva | 3 - Impraticável | 5 - Instável | 4 - Não houveram atividades

# --- Open-Meteo e Nominatim: APIs públicas, sem chave (padrões abaixo; normalmente não mudam) ---
# OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ============================================================
#  TÓPICOS E PROMPTS  (padrões; normalmente não precisa mudar)
# ============================================================
# TOPICS_FILE=config/topics.yaml
# PROMPTS_DIR=prompts

# ============================================================
#  SERVIDOR E REDE
# ============================================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

HTTP_TIMEOUT=120        # segundos para chamadas externas (DNIT/OpenAI)
HTTP_MAX_RETRIES=2      # tentativas extras em caso de falha temporária
